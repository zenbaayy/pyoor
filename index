let wishlist = JSON.parse(localStorage.getItem('pyoor_wishlist') || '[]');
let cart = JSON.parse(localStorage.getItem('pyoor_cart') || '[]');
let currentProductId = null;
let payMethod = 'cod';
let amountMode = 'full';

function save(){
  localStorage.setItem('pyoor_wishlist', JSON.stringify(wishlist));
  localStorage.setItem('pyoor_cart', JSON.stringify(cart));
}
function fmt(n){ return 'Rs.' + n.toLocaleString(); }
function findProduct(id){ return products.find(p=>p.id===id); }

function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(()=>t.classList.remove('show'), 1800);
}

function toggleWishlist(id, ev){
  if(ev) ev.stopPropagation();
  const i = wishlist.indexOf(id);
  if(i>-1){ wishlist.splice(i,1); toast('Removed from wishlist'); }
  else { wishlist.push(id); toast('Added to wishlist'); }
  save(); renderAll();
}

function addToCart(id, qty, ev){
  if(ev) ev.stopPropagation();
  qty = qty || 1;
  const p = findProduct(id);
  if(p.soldOut){ toast('This product is sold out'); return; }
  const line = cart.find(c=>c.id===id);
  if(line) line.qty += qty; else cart.push({id, qty});
  save(); renderAll();
  toast('Added to cart');
}
function removeFromCart(id){
  cart = cart.filter(c=>c.id!==id);
  save(); renderAll();
}
function changeQty(id, delta){
  const line = cart.find(c=>c.id===id);
  if(!line) return;
  line.qty += delta;
  if(line.qty<=0){ removeFromCart(id); return; }
  save(); renderAll();
}

function cartTotal(){
  return cart.reduce((sum,c)=>{ const p=findProduct(c.id); return sum + (p?p.price*c.qty:0); },0);
}

function productCard(p){
  const isWish = wishlist.includes(p.id);
  return `
  <div class="card">
    <div class="card-media" onclick="openProduct(${p.id})">
      <img src="${p.img}" alt="${p.name}">
      <button class="heart ${isWish?'active':''}" onclick="toggleWishlist(${p.id}, event)" aria-label="Toggle wishlist">${isWish?'♥':'♡'}</button>
      ${p.soldOut?'<span class="sold-tag">Sold out</span>':''}
    </div>
    <div class="card-body">
      <div class="cat">${p.cat}</div>
      <div class="pname" onclick="openProduct(${p.id})">${p.name}</div>
      <div class="pprice">${fmt(p.price)}</div>
      <div class="card-foot">
        <button class="btn btn-blue btn-sm btn-block" ${p.soldOut?'disabled':''} onclick="addToCart(${p.id},1,event)">${p.soldOut?'Sold out':'Add to cart'}</button>
      </div>
    </div>
  </div>`;
}

let currentSort = 'featured';
function setSort(val){ currentSort = val; renderHomeGrid(); }

function sortedProducts(){
  const list = products.slice();
  switch(currentSort){
    case 'az': list.sort((a,b)=>a.name.localeCompare(b.name)); break;
    case 'za': list.sort((a,b)=>b.name.localeCompare(a.name)); break;
    case 'price-asc': list.sort((a,b)=>a.price-b.price); break;
    case 'price-desc': list.sort((a,b)=>b.price-a.price); break;
    case 'date-old': list.sort((a,b)=>a.id-b.id); break;
    case 'date-new': list.sort((a,b)=>b.id-a.id); break;
    case 'bestselling': list.sort((a,b)=>(b.reviews||0)-(a.reviews||0)); break;
    case 'relevant':
    case 'featured':
    default: break; // store's default/featured order
  }
  return list;
}

function renderHomeGrid(){
  const list = sortedProducts();
  document.getElementById('homeGrid').innerHTML = list.map(productCard).join('');
  document.getElementById('prodCount').textContent = products.length + ' products';
}

function openProduct(id){
  currentProductId = id;
  nav('product');
}

function renderProduct(){
  const p = findProduct(currentProductId);
  if(!p){ document.getElementById('pdWrap').innerHTML=''; return; }
  const isWish = wishlist.includes(p.id);
  const ratingHtml = p.rating ? `<div class="pd-rating">${p.rating.toFixed(1)} / 5.0 · ${p.reviews} review${p.reviews===1?'':'s'}</div>` : '';
  document.getElementById('pdWrap').innerHTML = `
    <div class="pd-media"><img src="${p.img}" alt="${p.name}"></div>
    <div class="pd-info">
      <div class="cat">${p.cat}</div>
      <h1>${p.name}</h1>
      ${ratingHtml}
      <div class="price">${fmt(p.price)}</div>
      <div class="desc">${p.desc || ''}</div>
      <div class="qty-row">
        <div class="qty-box">
          <button onclick="pdQty(-1)">–</button><span id="pdQtyVal">1</span><button onclick="pdQty(1)">+</button>
        </div>
      </div>
      <div class="pd-actions">
        <button class="btn btn-blue" ${p.soldOut?'disabled':''} onclick="addToCart(${p.id}, window.pdQtyN||1)">${p.soldOut?'Sold out':'Add to cart'}</button>
        <button class="pd-heart ${isWish?'active':''}" onclick="toggleWishlist(${p.id})">${isWish?'♥ In wishlist':'♡ Add to wishlist'}</button>
      </div>
    </div>`;
  window.pdQtyN = 1;
  document.getElementById('relatedGrid').innerHTML = products
    .filter(x=>x.cat===p.cat && x.id!==p.id)
    .concat(products.filter(x=>x.cat!==p.cat && x.id!==p.id))
    .slice(0,4)
    .map(productCard).join('');
}
function pdQty(delta){
  window.pdQtyN = Math.max(1, (window.pdQtyN||1)+delta);
  document.getElementById('pdQtyVal').textContent = window.pdQtyN;
}

function renderWishlist(){
  const box = document.getElementById('wishlistBody');
  if(wishlist.length===0){
    box.innerHTML = `<div class="empty-state"><div class="glyph">♡</div><h3>Your wishlist is empty</h3><p>Tap the heart on any product to save it here.</p><a class="btn btn-outline" style="margin-top:14px" href="#" onclick="nav('home');return false;">Browse products</a></div>`;
    return;
  }
  box.innerHTML = `<div class="row-list">` + wishlist.map(id=>{
    const p = findProduct(id); if(!p) return '';
    return `<div class="row-item">
      <img src="${p.img}" alt="${p.name}">
      <div class="ri-info">
        <div class="n" onclick="openProduct(${p.id})">${p.name}</div>
        <div class="p">${fmt(p.price)}</div>
      </div>
      <div class="ri-actions">
        <button class="btn btn-blue btn-sm" ${p.soldOut?'disabled':''} onclick="addToCart(${p.id},1)">Add to cart</button>
        <button class="link-remove" onclick="toggleWishlist(${p.id})">Remove</button>
      </div>
    </div>`;
  }).join('') + `</div>`;
}

function renderCart(){
  const box = document.getElementById('cartBody');
  if(cart.length===0){
    box.innerHTML = `<div class="empty-state"><div class="glyph">🛍</div><h3>Your cart is empty</h3><p>Add something you'll love.</p><a class="btn btn-outline" style="margin-top:14px" href="#" onclick="nav('home');return false;">Browse products</a></div>`;
    return;
  }
  const rows = cart.map(c=>{
    const p = findProduct(c.id); if(!p) return '';
    return `<div class="row-item">
      <img src="${p.img}" alt="${p.name}">
      <div class="ri-info">
        <div class="n" onclick="openProduct(${p.id})">${p.name}</div>
        <div class="p">${fmt(p.price)}</div>
      </div>
      <div class="ri-actions">
        <div class="qty-box"><button onclick="changeQty(${p.id},-1)">–</button><span>${c.qty}</span><button onclick="changeQty(${p.id},1)">+</button></div>
        <button class="link-remove" onclick="removeFromCart(${p.id})">Remove</button>
      </div>
    </div>`;
  }).join('');
  const total = cartTotal();
  box.innerHTML = `<div class="row-list">${rows}</div>
    <div class="cart-summary">
      <div class="line"><span>Subtotal</span><span>${fmt(total)}</span></div>
      <div class="line" style="color:var(--ink-soft)"><span>Shipping</span><span>Calculated at checkout</span></div>
      <div class="line total"><span>Estimated total</span><span>${fmt(total)}</span></div>
      <button class="btn btn-primary btn-block" style="margin-top:14px" onclick="nav('checkout')">Proceed to checkout</button>
    </div>`;
}

function setPayMethod(m){
  payMethod = m;
  ['cod','card','bank'].forEach(k=>{
    document.getElementById('opt-'+k).classList.toggle('selected', k===m);
  });
  document.getElementById('cardFields').style.display = m==='card' ? 'block' : 'none';
  document.getElementById('bankFields').style.display = m==='bank' ? 'block' : 'none';
}
function setAmountMode(mode){
  amountMode = mode;
  document.getElementById('amtFullBtn').classList.toggle('selected', mode==='full');
  document.getElementById('amtHalfBtn').classList.toggle('selected', mode==='half');
  renderCheckoutSummary();
}
function renderCheckoutSummary(){
  const total = cartTotal();
  const due = amountMode==='full' ? total : Math.round(total/2);
  const remaining = total - due;
  document.getElementById('checkoutSummary').innerHTML = `
    <div class="line"><span>Order subtotal</span><span>${fmt(total)}</span></div>
    ${amountMode==='half' ? `<div class="line"><span>Remaining on delivery</span><span>${fmt(remaining)}</span></div>` : ''}
    <div class="line total"><span>Due now</span><span>${fmt(due)}</span></div>`;
}
function placeOrder(){
  if(cart.length===0){ toast('Your cart is empty'); return; }
  toast('Order details captured — no real payment was processed (prototype)');
}

function updateBadges(){
  const wb = document.getElementById('wishBadge');
  const cb = document.getElementById('cartBadge');
  wb.style.display = wishlist.length ? 'flex' : 'none'; wb.textContent = wishlist.length;
  const cCount = cart.reduce((s,c)=>s+c.qty,0);
  cb.style.display = cCount ? 'flex' : 'none'; cb.textContent = cCount;
}

function subscribeNews(ev){
  ev.preventDefault();
  toast('Subscribed! (demo only)');
  ev.target.reset();
}

function nav(view){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById('view-'+view).classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
  if(view==='product') renderProduct();
  if(view==='checkout') renderCheckoutSummary();
  document.getElementById('nav-home').classList.toggle('active', view==='home');
  document.getElementById('nav-wishlist').classList.toggle('active', view==='wishlist');
}

function renderAll(){
  renderHomeGrid();
  renderWishlist();
  renderCart();
  updateBadges();
  if(document.getElementById('view-product').classList.contains('active')) renderProduct();
  if(document.getElementById('view-checkout').classList.contains('active')) renderCheckoutSummary();
}

renderAll();
</script>
</body>
</html>
