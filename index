<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pyoor Body Essentials — Redesign Prototype</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;1,400&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#FAF6EF;
    --panel:#FFFFFF;
    --ink:#362B22;
    --ink-soft:#6B5E4F;
    --brown:#8B5E3C;
    --brown-dark:#5E3E27;
    --brown-tint:#F1E6D8;
    --blue:#9FC6D8;
    --blue-dark:#4F7E93;
    --blue-tint:#E7F1F5;
    --line:#E6DECE;
    --error:#B3573F;
    --ok:#4C7A5C;
    --radius:14px;
    --radius-sm:8px;
    --shadow:0 6px 24px rgba(94,62,39,0.08);
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--cream);color:var(--ink);font-family:'Karla',sans-serif;font-size:16px;line-height:1.5;}
  h1,h2,h3,.serif{font-family:'Fraunces',serif;font-weight:500;color:var(--brown-dark);}
  a{color:inherit;text-decoration:none;}
  button{font-family:'Karla',sans-serif;cursor:pointer;border:none;}
  img{display:block;max-width:100%;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px;}

  /* Header */
  header.site{position:sticky;top:0;z-index:50;background:var(--cream);border-bottom:1px solid var(--line);}
  .topbar{background:var(--brown-dark);color:var(--blue-tint);font-size:13px;text-align:center;padding:7px 12px;letter-spacing:.02em;}
  .navrow{display:flex;align-items:center;justify-content:space-between;padding:18px 0;}
  .brand{font-family:'Fraunces',serif;font-style:italic;font-size:26px;color:var(--brown-dark);}
  .brand span{font-style:normal;color:var(--blue-dark);}
  nav.links{display:flex;gap:28px;font-size:15px;}
  nav.links a{padding:6px 2px;border-bottom:2px solid transparent;}
  nav.links a.active,nav.links a:hover{border-color:var(--blue-dark);color:var(--blue-dark);}
  .navicons{display:flex;align-items:center;gap:18px;}
  .icon-btn{position:relative;background:none;font-size:20px;color:var(--brown-dark);padding:4px;}
  .badge{position:absolute;top:-6px;right:-8px;background:var(--blue-dark);color:#fff;font-size:10px;min-width:16px;height:16px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 3px;}

  /* Hero */
  .hero{background:linear-gradient(120deg,var(--blue-tint) 0%,var(--cream) 60%);padding:64px 0 56px;}
  .hero .wrap{display:flex;align-items:center;gap:48px;flex-wrap:wrap;}
  .hero-copy{flex:1 1 380px;}
  .hero-copy .eyebrow{color:var(--blue-dark);font-weight:600;letter-spacing:.04em;font-size:13px;}
  .hero-copy h1{font-size:44px;line-height:1.1;margin:10px 0 16px;}
  .hero-copy p{color:var(--ink-soft);max-width:440px;margin-bottom:26px;}
  .hero-img{flex:1 1 320px;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);}
  .hero-img img{height:340px;width:100%;object-fit:cover;}

  .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:999px;font-weight:600;font-size:14.5px;transition:transform .15s ease, background .2s ease;}
  .btn:hover{transform:translateY(-1px);}
  .btn-primary{background:var(--brown-dark);color:#fff;}
  .btn-primary:hover{background:var(--brown);}
  .btn-outline{background:transparent;border:1.5px solid var(--brown-dark);color:var(--brown-dark);}
  .btn-outline:hover{background:var(--brown-dark);color:#fff;}
  .btn-blue{background:var(--blue-dark);color:#fff;}
  .btn-blue:hover{background:var(--blue);color:var(--brown-dark);}
  .btn-sm{padding:9px 16px;font-size:13px;}
  .btn-block{width:100%;justify-content:center;}
  .btn:disabled{opacity:.5;cursor:not-allowed;transform:none;}

  section{padding:52px 0;}
  .section-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:26px;flex-wrap:wrap;gap:8px;}
  .section-head h2{font-size:28px;margin:0;}
  .section-head p{color:var(--ink-soft);font-size:14px;}
  .sort-row{display:flex;align-items:center;justify-content:flex-end;gap:10px;margin-bottom:18px;font-size:13.5px;color:var(--ink-soft);}
  .sort-row select{padding:9px 12px;border:1px solid var(--line);border-radius:8px;background:#fff;font-family:'Karla',sans-serif;font-size:13.5px;color:var(--ink);}
  .sort-row select:focus{outline:2px solid var(--blue-dark);outline-offset:1px;}

  /* Product grid */
  .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;}
  .card{background:var(--panel);border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);transition:box-shadow .2s ease;display:flex;flex-direction:column;}
  .card:hover{box-shadow:var(--shadow);}
  .card-media{position:relative;aspect-ratio:1/1;background:var(--brown-tint);overflow:hidden;cursor:pointer;}
  .card-media img{width:100%;height:100%;object-fit:cover;}
  .heart{position:absolute;top:10px;right:10px;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--brown-dark);box-shadow:0 2px 6px rgba(0,0,0,.12);}
  .heart.active{color:#C4515A;}
  .sold-tag{position:absolute;bottom:10px;left:10px;background:var(--ink);color:#fff;font-size:11px;padding:4px 9px;border-radius:6px;}
  .card-body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1;}
  .card-body .pname{font-size:15px;font-weight:600;color:var(--ink);cursor:pointer;}
  .card-body .pname:hover{color:var(--blue-dark);}
  .card-body .pprice{color:var(--brown-dark);font-weight:700;font-size:14.5px;}
  .card-body .cat{font-size:11.5px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.04em;}
  .card-foot{margin-top:auto;padding-top:8px;}

  /* Product detail */
  .pd{display:flex;gap:44px;flex-wrap:wrap;}
  .pd-media{flex:1 1 400px;border-radius:var(--radius);overflow:hidden;background:var(--brown-tint);box-shadow:var(--shadow);}
  .pd-media img{width:100%;aspect-ratio:1/1;object-fit:cover;}
  .pd-info{flex:1 1 380px;}
  .pd-info .cat{color:var(--blue-dark);font-weight:600;font-size:13px;text-transform:uppercase;letter-spacing:.04em;}
  .pd-info h1{font-size:32px;margin:10px 0 6px;}
  .pd-info .price{font-size:22px;color:var(--brown-dark);font-weight:700;margin-bottom:16px;}
  .pd-info .desc{color:var(--ink-soft);margin-bottom:24px;max-width:480px;font-size:14.5px;line-height:1.65;}
  .pd-info .desc strong{color:var(--ink);}
  .pd-info .desc ul{margin:6px 0 12px;padding-left:20px;}
  .pd-info .desc li{margin-bottom:3px;}
  .pd-rating{font-size:13px;color:var(--brown);font-weight:600;margin-bottom:8px;}
  .qty-row{display:flex;align-items:center;gap:14px;margin-bottom:20px;}
  .qty-box{display:flex;align-items:center;border:1px solid var(--line);border-radius:999px;overflow:hidden;}
  .qty-box button{background:var(--brown-tint);width:34px;height:34px;font-size:16px;color:var(--brown-dark);}
  .qty-box span{width:34px;text-align:center;font-weight:600;}
  .pd-actions{display:flex;gap:12px;flex-wrap:wrap;}
  .pd-heart{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:999px;border:1.5px solid var(--line);background:#fff;font-weight:600;color:var(--ink);}
  .pd-heart.active{border-color:#C4515A;color:#C4515A;}

  .empty-state{text-align:center;padding:70px 20px;color:var(--ink-soft);}
  .empty-state .glyph{font-size:38px;margin-bottom:14px;}
  .empty-state h3{color:var(--brown-dark);margin-bottom:8px;}

  /* Wishlist / cart rows */
  .row-list{display:flex;flex-direction:column;gap:14px;}
  .row-item{display:flex;align-items:center;gap:16px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px;}
  .row-item img{width:72px;height:72px;border-radius:var(--radius-sm);object-fit:cover;background:var(--brown-tint);}
  .row-item .ri-info{flex:1;min-width:120px;}
  .row-item .ri-info .n{font-weight:600;cursor:pointer;}
  .row-item .ri-info .n:hover{color:var(--blue-dark);}
  .row-item .ri-info .p{color:var(--brown-dark);font-weight:700;font-size:14px;margin-top:2px;}
  .row-item .ri-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
  .link-remove{color:var(--error);font-size:13px;font-weight:600;background:none;}

  .cart-summary{background:var(--blue-tint);border-radius:var(--radius);padding:22px;margin-top:20px;max-width:360px;margin-left:auto;}
  .cart-summary .line{display:flex;justify-content:space-between;margin-bottom:8px;font-size:14.5px;}
  .cart-summary .total{font-weight:700;font-size:17px;border-top:1px solid rgba(79,126,147,.3);padding-top:10px;margin-top:10px;}

  /* Checkout */
  .checkout-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:36px;}
  .co-box{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:22px;margin-bottom:20px;}
  .co-box h3{font-size:16px;margin:0 0 14px;}
  .pay-option{display:flex;align-items:flex-start;gap:12px;border:1.5px solid var(--line);border-radius:var(--radius-sm);padding:13px 14px;margin-bottom:10px;cursor:pointer;}
  .pay-option.selected{border-color:var(--blue-dark);background:var(--blue-tint);}
  .pay-option input{margin-top:3px;}
  .pay-option .lbl{font-weight:600;font-size:14.5px;}
  .pay-option .sub{color:var(--ink-soft);font-size:12.5px;margin-top:2px;}
  .pay-detail{padding:14px 4px 4px 30px;}
  .field{margin-bottom:12px;}
  .field label{display:block;font-size:12.5px;color:var(--ink-soft);margin-bottom:5px;}
  .field input{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:8px;font-family:'Karla',sans-serif;font-size:14px;background:#fff;}
  .field input:focus{outline:2px solid var(--blue-dark);outline-offset:1px;}
  .field-row{display:flex;gap:12px;}
  .field-row .field{flex:1;}
  .bank-info{background:var(--brown-tint);border-radius:8px;padding:14px;font-size:13.5px;color:var(--ink-soft);line-height:1.6;}
  .amount-toggle{display:flex;gap:10px;margin-bottom:14px;}
  .amt-btn{flex:1;padding:13px;border-radius:var(--radius-sm);border:1.5px solid var(--line);background:#fff;text-align:left;}
  .amt-btn.selected{border-color:var(--brown-dark);background:var(--brown-tint);}
  .amt-btn .t{font-weight:700;font-size:14px;}
  .amt-btn .s{font-size:12px;color:var(--ink-soft);}
  .notice{font-size:12.5px;color:var(--ink-soft);background:var(--blue-tint);border-radius:8px;padding:10px 12px;margin-top:6px;}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--brown-dark);color:#fff;padding:12px 22px;border-radius:999px;font-size:14px;box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:opacity .25s ease, transform .25s ease;z-index:200;}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(-6px);}

  /* Footer */
  footer.site{background:var(--brown-dark);color:var(--blue-tint);margin-top:40px;}
  .foot-top{padding:52px 0 30px;}
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:32px;}
  .foot-grid h4{color:#fff;font-family:'Fraunces',serif;font-weight:500;font-size:16px;margin:0 0 14px;}
  .foot-grid p, .foot-grid a{color:#D9CBB8;font-size:13.5px;}
  .foot-grid ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px;}
  .foot-grid a:hover{color:#fff;}
  .foot-social{display:flex;gap:10px;margin-top:14px;}
  .foot-social a{width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:14px;}
  .foot-social a:hover{background:var(--blue-dark);}
  .news-row{display:flex;gap:8px;margin-top:10px;}
  .news-row input{flex:1;padding:10px 12px;border-radius:999px;border:none;font-size:13px;}
  .news-row button{background:var(--blue-dark);color:#fff;padding:10px 16px;border-radius:999px;font-weight:600;font-size:13px;}
  .foot-bottom{border-top:1px solid rgba(255,255,255,.12);padding:16px 0;display:flex;justify-content:space-between;font-size:12.5px;color:#C9BAA4;flex-wrap:wrap;gap:8px;}

  .view{display:none;}
  .view.active{display:block;}

  @media(max-width:900px){
    .grid{grid-template-columns:repeat(2,1fr);}
    .checkout-grid{grid-template-columns:1fr;}
    .foot-grid{grid-template-columns:1fr 1fr;}
    nav.links{display:none;}
    .hero-copy h1{font-size:32px;}
  }
  @media(max-width:520px){
    .grid{grid-template-columns:repeat(2,1fr);gap:12px;}
    .foot-grid{grid-template-columns:1fr;}
    .field-row{flex-direction:column;}
  }
</style>
</head>
<body>

<div class="toast" id="toast"></div>

<header class="site">
  <div class="topbar">Use code <strong>PYOOR</strong> at checkout · Free delivery on orders over Rs.2000</div>
  <div class="wrap navrow">
    <a class="brand" href="#" onclick="nav('home');return false;">Pyoor <span>Body Essentials</span></a>
    <nav class="links">
      <a href="#" onclick="nav('home');return false;" id="nav-home">Home</a>
      <a href="#" onclick="nav('home');document.getElementById('shop').scrollIntoView({behavior:'smooth'});return false;">Shop</a>
      <a href="#" onclick="nav('wishlist');return false;" id="nav-wishlist">Wishlist</a>
    </nav>
    <div class="navicons">
      <button class="icon-btn" onclick="nav('wishlist')" aria-label="Wishlist">♡<span class="badge" id="wishBadge" style="display:none">0</span></button>
      <button class="icon-btn" onclick="nav('cart')" aria-label="Cart">🛍<span class="badge" id="cartBadge" style="display:none">0</span></button>
    </div>
  </div>
</header>

<!-- HOME -->
<div class="view active" id="view-home">
  <div class="hero">
    <div class="wrap">
      <div class="hero-copy">
        <div class="eyebrow">Buff &amp; Glow</div>
        <h1>Radiant skin,<br>naturally yours.</h1>
        <p>Body care crafted from clean, effective ingredients — made for glowing, healthy skin.</p>
        <a href="#" class="btn btn-primary" onclick="document.getElementById('shop').scrollIntoView({behavior:'smooth'});return false;">Shop all products</a>
      </div>
      <div class="hero-img"><img src="https://www.pyoorbodyessentials.com/cdn/shop/files/IMG_7987.jpg?v=1782979234&width=800" alt="Pyoor Body Essentials"></div>
    </div>
  </div>
  <section class="wrap" id="shop">
    <div class="section-head">
      <h2>Featured products</h2>
      <p id="prodCount"></p>
    </div>
    <div class="sort-row">
      <label for="sortSelect">Sort by:</label>
      <select id="sortSelect" onchange="setSort(this.value)">
        <option value="featured">Featured</option>
        <option value="relevant">Most relevant</option>
        <option value="bestselling">Best selling</option>
        <option value="az">Alphabetically, A-Z</option>
        <option value="za">Alphabetically, Z-A</option>
        <option value="price-asc">Price, low to high</option>
        <option value="price-desc">Price, high to low</option>
        <option value="date-old">Date, old to new</option>
        <option value="date-new">Date, new to old</option>
      </select>
    </div>
    <div class="grid" id="homeGrid"></div>
  </section>
</div>

<!-- PRODUCT DETAIL -->
<div class="view" id="view-product">
  <section class="wrap">
    <div class="pd" id="pdWrap"></div>
  </section>
  <section class="wrap">
    <div class="section-head"><h2>You May Also Like</h2></div>
    <div class="grid" id="relatedGrid"></div>
  </section>
</div>

<!-- WISHLIST -->
<div class="view" id="view-wishlist">
  <section class="wrap">
    <div class="section-head"><h2>Your Wishlist</h2></div>
    <div id="wishlistBody"></div>
  </section>
</div>

<!-- CART -->
<div class="view" id="view-cart">
  <section class="wrap">
    <div class="section-head"><h2>Your Cart</h2></div>
    <div id="cartBody"></div>
  </section>
</div>

<!-- CHECKOUT -->
<div class="view" id="view-checkout">
  <section class="wrap">
    <div class="section-head"><h2>Checkout</h2></div>
    <div class="checkout-grid">
      <div>
        <div class="co-box">
          <h3>Shipping details</h3>
          <div class="field-row">
            <div class="field"><label>Full name</label><input type="text" placeholder="Your name"></div>
            <div class="field"><label>Phone number</label><input type="text" placeholder="03xx-xxxxxxx"></div>
          </div>
          <div class="field"><label>Delivery address</label><input type="text" placeholder="House, street, city"></div>
        </div>

        <div class="co-box">
          <h3>Payment amount</h3>
          <div class="amount-toggle">
            <button class="amt-btn selected" id="amtFullBtn" onclick="setAmountMode('full')">
              <div class="t">Full payment</div><div class="s">Pay the complete order now</div>
            </button>
            <button class="amt-btn" id="amtHalfBtn" onclick="setAmountMode('half')">
              <div class="t">50% advance</div><div class="s">Pay half now, rest on delivery</div>
            </button>
          </div>
          <div class="notice">Advance-payment orders are confirmed once the 50% advance is received; the remaining balance follows the store's standard order policy.</div>
        </div>

        <div class="co-box">
          <h3>Payment method</h3>
          <label class="pay-option selected" id="opt-cod">
            <input type="radio" name="pay" value="cod" checked onchange="setPayMethod('cod')">
            <div><div class="lbl">Cash on Delivery</div><div class="sub">Pay in cash when your order arrives</div></div>
          </label>
          <label class="pay-option" id="opt-card">
            <input type="radio" name="pay" value="card" onchange="setPayMethod('card')">
            <div>
              <div class="lbl">Card payment</div><div class="sub">Debit / credit card</div>
              <div class="pay-detail" id="cardFields" style="display:none">
                <div class="field"><label>Cardholder name</label><input type="text" placeholder="Name on card"></div>
                <div class="field"><label>Card number</label><input type="text" placeholder="•••• •••• •••• ••••" inputmode="numeric"></div>
                <div class="field-row">
                  <div class="field"><label>Expiry date</label><input type="text" placeholder="MM/YY"></div>
                  <div class="field"><label>CVV</label><input type="text" placeholder="•••" inputmode="numeric"></div>
                </div>
                <div class="notice">Card details are UI-only in this prototype — no real payment gateway is connected yet.</div>
              </div>
            </div>
          </label>
          <label class="pay-option" id="opt-bank">
            <input type="radio" name="pay" value="bank" onchange="setPayMethod('bank')">
            <div>
              <div class="lbl">Bank transfer</div><div class="sub">Transfer directly to our account</div>
              <div class="pay-detail" id="bankFields" style="display:none">
                <div class="bank-info">
                  Bank name: <em>[add bank name]</em><br>
                  Account title: <em>[add account title]</em><br>
                  Account / IBAN: <em>[add account number]</em><br>
                  Please send your payment screenshot to confirm your order.
                </div>
              </div>
            </div>
          </label>
        </div>
      </div>

      <div>
        <div class="co-box">
          <h3>Order summary</h3>
          <div id="checkoutSummary"></div>
          <button class="btn btn-primary btn-block" style="margin-top:16px" onclick="placeOrder()">Place order</button>
        </div>
      </div>
    </div>
  </section>
</div>

<footer class="site">
  <div class="wrap foot-top">
    <div class="foot-grid">
      <div>
        <h4>Pyoor Body Essentials</h4>
        <p>Top-quality body care made with clean, effective ingredients — for skin that feels as good as it looks. Handcrafted and shipped across Pakistan.</p>
        <div class="foot-social">
          <a href="https://www.instagram.com/pyoorbodyessentials" aria-label="Instagram">IG</a>
          <a href="https://www.tiktok.com/@pyoorbodyessentials" aria-label="TikTok">TT</a>
        </div>
      </div>
      <div>
        <h4>Quick links</h4>
        <ul>
          <li><a href="#" onclick="nav('home');return false;">Home</a></li>
          <li><a href="#" onclick="nav('home');return false;">Shop</a></li>
          <li><a href="#" onclick="nav('wishlist');return false;">Wishlist</a></li>
          <li><a href="#" onclick="nav('cart');return false;">Cart</a></li>
        </ul>
      </div>
      <div>
        <h4>Customer support</h4>
        <ul>
          <li><a href="#">Contact us</a></li>
          <li><a href="#">Shipping information</a></li>
          <li><a href="#">Return &amp; refund policy</a></li>
          <li><a href="#">Privacy policy</a></li>
          <li><a href="#">Terms &amp; conditions</a></li>
          <li><a href="#">FAQs</a></li>
        </ul>
      </div>
      <div>
        <h4>Get in touch</h4>
        <p>Phone: <em>[add phone number]</em><br>
        Email: <em>[add email address]</em><br>
        Address: <em>[add store address]</em></p>
        <h4 style="margin-top:18px">Newsletter</h4>
        <form class="news-row" onsubmit="subscribeNews(event)">
          <input type="email" placeholder="Your email" required>
          <button type="submit">Join</button>
        </form>
      </div>
    </div>
  </div>
  <div class="wrap foot-bottom">
    <span>© 2026 Pyoor Body Essentials</span>
    <span>Design prototype — for review only</span>
  </div>
</footer>

<script>
const products = [
